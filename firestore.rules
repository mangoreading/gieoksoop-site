rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 붙여넣어 배포하세요.
//
// 2026-09-17 업데이트: 관리자 화면(admin.gieoksoop.com) 추가로 아래 컬렉션이 새로 생겼습니다.
//   - admins        : 관리자 계정 목록(uid를 문서ID로 사용). role 필드로 superadmin/admin 구분.
//   - guides        : 사용가이드 섹션(공개 사이트 guide.html이 여기서 읽어옴)
//   - notices       : 공지사항(공개 사이트 notice.html이 여기서 읽어옴)
//   - system_config : 서비스 운영용 설정값(관리자만 열람 가능, 절대 공개 노출 금지)
//
// 2026-09-21 업데이트: 관리자 화면에 "서비스 일시중지"와 "결제내역 수동 등록" 기능이 추가되어
//   아래 내용이 바뀌었습니다.
//   - users/{userId} : suspended(정지여부)/suspend_note(정지 메모)/suspended_at/suspended_by/
//     suspended_resumed_at/suspended_resumed_by 필드가 새로 생김. subscription_status/plan과
//     마찬가지로 본인이 직접 바꿀 수 없고 관리자만 바꿀 수 있어야 함(안 그러면 본인이 스스로
//     정지를 풀 수 있게 되는 구멍이 생김).
//   - payments      : 결제내역(PortOne 연동 전까지는 관리자가 계좌이체 확인 후 수동 등록).
//     본인은 자기 결제내역만 읽을 수 있고, 쓰기는 관리자만 가능.
//
// 2026-10-10 업데이트: 고객 문의 폼 추가로 inquiries 컬렉션 규칙이 새로 생겼습니다(아래 참고).
//
// 핵심 원칙: 본인의 users/{내uid} 문서만 읽고 쓸 수 있음(다른 사용자 정보는 절대 볼 수 없음),
//   단 admins 컬렉션에 자기 uid 문서가 있는 사람(=관리자)은 모든 회원 문서를 읽고 고객지원
//   목적으로 구독상태를 고쳐줄 수 있음. superadmin만 관리자 계정 자체를 추가/변경/삭제할 수 있음.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    match /users/{userId} {
      // 가입 시 만들 수 있는 필드를 화이트리스트로 제한한다(구독/결제 관련 필드를 임의로 심어두지 못하게).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.subscription_status == 'none'
                    && request.resource.data.keys().hasOnly(['name', 'email', 'created_at', 'subscription_status', 'subscription_plan']);

      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();

      // 2026-10 보안 강화: 본인은 프로필 필드(name, phone)만 바꿀 수 있다.
      // 예전에는 subscription_status/plan/정지 필드만 막아서, 본인이 next_billing_at(이용 만료일),
      // auto_renew, 결제/환불 계산용 필드(last_one_time_*, app_last_login_at 등)를 직접 고쳐
      // 무료로 이용을 연장하거나 환불액을 조작할 수 있는 구멍이 있었다. 결제·구독 관련 필드는
      // 서버(Cloudflare Worker, 서비스 계정)와 관리자만 바꿀 수 있다.
      allow update: if (request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']))
                    || isAdmin();

      allow delete: if false;
    }

    // 관리자 계정 자체. 문서ID = 그 관리자의 Firebase Auth uid.
    // 최초 1명(첫 superadmin)은 이 규칙상 아무도 만들 수 없으므로, Firebase 콘솔에서
    // 수동으로 딱 한 번 만들어줘야 한다(관리자 화면 안내 문서 참고).
    match /admins/{uid} {
      allow read: if isAdmin();
      allow create, update: if isSuperAdmin();
      // 마지막 안전장치: 아무리 superadmin이라도 "자기 자신"은 삭제할 수 없게 막아서
      // 실수로 관리자가 0명이 되는 사고를 방지한다.
      allow delete: if isSuperAdmin() && uid != request.auth.uid;
    }

    // 사용가이드 섹션 — 로그인 여부와 상관없이 누구나 읽을 수 있어야 공개 사이트에서 보여줄 수 있다.
    match /guides/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 공지사항 — 마찬가지로 공개 읽기, 관리자만 작성/수정/삭제.
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 결제내역 — PortOne 연동 전까지는 관리자가 계좌이체 등을 확인하고 수동으로 등록/삭제한다.
    // 본인은 자기 uid로 된 결제내역만 조회할 수 있고(추후 "내 결제내역" 화면용), 쓰기는 관리자만.
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // 고객 문의 — 로그인 + 이메일 인증을 마친 사용자만 작성할 수 있고, 본인 문의만 읽을 수 있다.
    // 문서 ID는 "{uid}_{YYYYMMDD}_{1~5}" 형식만 허용해서 한 사용자가 하루에 최대 5건까지만 만들 수 있다
    // (같은 ID는 create가 한 번만 가능하고 사용자는 수정/삭제할 수 없어서 이 횟수 제한이 우회되지 않는다).
    // 답변·상태 변경·삭제는 관리자만(알림 처리용 필드는 서버가 서비스 계정으로 기록).
    match /inquiries/{inquiryId} {
      function validNewInquiry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'email', 'name', 'category', 'title', 'message', 'status', 'created_at'])
          && d.keys().hasAll(['uid', 'email', 'category', 'title', 'message', 'status', 'created_at'])
          && d.uid == request.auth.uid
          && d.email is string && d.email.lower() == request.auth.token.email.lower()
          && (!('name' in d) || (d.name is string && d.name.size() <= 60))
          && d.category in ['payment', 'subscription', 'account', 'app', 'etc']
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
          && d.message is string && d.message.size() >= 5 && d.message.size() <= 2000
          && d.status == 'open'
          && d.created_at == request.time;
      }

      allow create: if isSignedIn()
                    && request.auth.token.email_verified == true
                    && inquiryId.matches(request.auth.uid + '_[0-9]{8}_[1-5]')
                    && validNewInquiry();
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 서비스 운영용 설정값(각종 key-value). 절대 공개되면 안 되므로 관리자만 읽고 쓸 수 있다.
    match /system_config/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
